# Local development without Docker: copy to anumati-server/.env
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://anumati:anumati@localhost:5432/anumati
# 32+ characters. `openssl rand -hex 32`
JWT_SECRET=
JWT_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:3000

# Seeds demo accounts/files and enables the clock and clash controls. Refused in production.
DEMO_MODE=true
# fixture | live
ADAPTER_MODE=fixture
# demo | external   (demo is refused in production)
DSC_MODE=demo

DOCUMENT_STORE_DIR=./var/documents
MAX_UPLOAD_BYTES=20971520
LOGIN_RATE_LIMIT=10
EXTRACTION_TOKEN=
LOG_LEVEL=info

# --- Live integrations (ADAPTER_MODE=live) ------------------------------------
# APISETU_BASE_URL=
# APISETU_CLIENT_ID=
# APISETU_API_KEY=
# MAITRI_BASE_URL=
# MAITRI_API_KEY=
# MAITRI single sign-on — the token's signature is checked against this JWKS.
# MAITRI_JWKS_URL=
# MAITRI_ISSUER=
# MAITRI_AUDIENCE=
# Department endpoints, JSON: {"mpcb":"https://...","mfs":"https://..."}
# DEPT_ENDPOINTS={}
# DEPT_MTLS_CERT=
# DEPT_MTLS_KEY=
# DEPT_MTLS_CA=

{
  "name": "anumati-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ANUMATI API, workers and database — the sequencing and coordination layer on top of MAITRI 2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "ledger:verify": "tsx --env-file-if-exists=.env src/cli/verify-ledger.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.2"
  }
}

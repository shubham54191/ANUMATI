# Copy to .env for docker compose. Never commit .env.

# --- Database -----------------------------------------------------------------
POSTGRES_USER=anumati
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anumati

# --- API ----------------------------------------------------------------------
# 32+ random characters. `openssl rand -hex 32` makes one.
JWT_SECRET=
# development = demo stack. production refuses DEMO_MODE=true and DSC_MODE=demo.
ANUMATI_NODE_ENV=development
DEMO_MODE=true
# fixture = recorded government answers (no network). live = call the real systems.
ADAPTER_MODE=fixture
# demo = labelled test signer. external = officers sign with their own DSC; the server only verifies.
DSC_MODE=demo
CORS_ORIGINS=http://localhost:3000
# Lets the extraction pipeline post drafts (24+ characters). Leave empty to disable.
EXTRACTION_TOKEN=
LOG_LEVEL=info

# --- Web ----------------------------------------------------------------------
# The URL the *browser* uses to reach the API.
PUBLIC_API_URL=http://localhost:4000
